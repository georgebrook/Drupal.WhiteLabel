{
  "name": "white_label",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "NODE_ENV=development node build/watch.mjs",
    "build": "NODE_ENV=development vite build --config build/vite.config.mjs",
    "build:prod": "NODE_ENV=production vite build --config build/vite.config.mjs",
    "lint": "eslint 'components/**/src/**/*.js' && stylelint 'components/**/src/**/*.scss'",
    "lint:ci": "eslint 'components/**/src/**/*.js' --max-warnings=0 && stylelint 'components/**/src/**/*.scss' --max-warnings=0",
    "lint:fix": "eslint 'components/**/src/**/*.js' --fix && stylelint 'components/**/src/**/*.scss' --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "glob": "^10.4.1",
    "chokidar": "^3.6.0",
    "sass": "^1.77.0",
    "vite-plugin-eslint2": "^4.4.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "vite-plugin-stylelint": "^5.3.1",
    "stylelint": "^16.6.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-order": "^6.0.4",
    "postcss-scss": "^4.0.9",
    "svgo": "^4.1.0",
    "prettier": "^3.3.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-babel": "^6.1.0",
    "core-js": "^3.50.0"
  }
}
