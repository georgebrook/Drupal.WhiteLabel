{
  "name": "white_label",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node build/watch.js",
    "build": "vite build --config build/vite.config.js",
    "build:prod": "NODE_ENV=production vite build --config build/vite.config.js",
    "lint": "eslint 'components/**/src/**/*.js' && stylelint 'components/**/src/**/*.scss'",
    "lint:fix": "eslint 'components/**/src/**/*.js' --fix && stylelint 'components/**/src/**/*.scss' --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "glob": "^10.4.1",
    "chokidar": "^3.6.0",
    "sass": "^1.77.0",
    "vite-plugin-eslint2": "^4.4.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^15.0.0",
    "eslint-config-airbnb-extended": "^1.0.0",
    "eslint-config-prettier": "^9.1.0",
    "vite-plugin-stylelint": "^5.3.1",
    "stylelint": "^16.6.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-order": "^6.0.4",
    "postcss-scss": "^4.0.9",
    "vite-svg-spritemap-plugin": "^1.0.4",
    "prettier": "^3.3.0"
  }
}
